# Copy to .env (or .env.local) and adjust. Every value is optional for local development: with no DATABASE_URL the API
# uses an embedded PostgreSQL (PGlite) stored under server/data/pg, so `npm install && npm run dev` just works.

# --- Server -----------------------------------------------------------------
PORT=8787
NODE_ENV=development
# Number of reverse proxies in front of the app (Cloudflare Worker + Render = 2; nginx or a PaaS router alone = 1).
# Needed in production so rate limiting sees the real client.
TRUST_PROXY=
# Comma-separated origins allowed to call the public /api cross-origin. Leave empty when the site and API
# share an origin (the default). The admin API is never cross-origin.
ALLOWED_ORIGINS=
# Max write requests per IP per 15 minutes on each form endpoint.
RATE_LIMIT_MAX=30

# --- Database -----------------------------------------------------------------
# PostgreSQL 14 or newer. REQUIRED when NODE_ENV=production. On Neon, use the *pooled* connection string.
#   DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=
# "" (plain) | true (verify the server certificate) | no-verify (TLS without verification, some managed hosts)
DATABASE_SSL=
PG_POOL_MAX=10
# Development only (no DATABASE_URL): where the embedded database lives. Defaults to server/data/pg.
PGLITE_DIR=
DATA_DIR=

# --- Staff console (/admin) -----------------------------------------------------
# One account, read from the environment (no user table). The password needs 12+ characters.
# Locally, leave both empty and the API prints a throw-away login when it starts.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: signs the session cookie. If empty it is derived from ADMIN_PASSWORD (changing the password signs everyone out).
SESSION_SECRET=
ADMIN_SESSION_HOURS=8
ADMIN_LOGIN_LIMIT=10
# auto = Secure cookie in production or over https. Set false ONLY to try a production build on http://localhost.
ADMIN_COOKIE_SECURE=auto

# --- Demo booking ---------------------------------------------------------------
# Slots are in India time (IST), Monday to Friday.
DEMO_START_HOUR=10
DEMO_END_HOUR=18
DEMO_SLOT_MINUTES=30
DEMO_NOTICE_HOURS=12
DEMO_HORIZON_DAYS=21

# --- Google: Calendar + Meet link, Drive for resumes, Gmail for notifications -------------------
# One OAuth refresh token for the company Google account (see README, "Google setup"). Create the token with
# `npm run google:authorize` and check it with `npm run google:check`. Step by step: docs/GOOGLE_SETUP.md. Without these the site still works: demos are stored as "requested" (no Meet link is
# created) and resume upload is refused in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# The Drive folder for résumés: the part of its address after /folders/. Needs full Drive access (npm run google:authorize asks for it).
GOOGLE_DRIVE_FOLDER_ID=
# Only used when no folder id is given: the app creates and uses a folder with this name.
GOOGLE_DRIVE_FOLDER=Zenitheum applications
# Who is invited to every demo and gets every notification.
TEAM_EMAIL=zenitheumsolutions@gmail.com

# --- Fallback e-mail over SMTP (optional) ---------------------------------------------
# Free hosts such as Render block SMTP, so use the Google route there. Handy on your own server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Zenitheum Website <zenitheumsolutions@gmail.com>"
MAIL_TO_TEAM=

# --- Docker Compose (see docker-compose.yml) ------------------------------------------
POSTGRES_PASSWORD=
WEB_PORT=8080
