# Copy to .env and adjust. Every value is optional for local development: with no DATABASE_URL the API uses an
# embedded PostgreSQL (PGlite) stored under server/data/pg, so `npm install && npm run dev` just works.

# --- Server -----------------------------------------------------------------
PORT=8787
NODE_ENV=development
# Set to the number of reverse proxies in front of the app (1 behind nginx or a PaaS router) so rate limiting
# and analytics see the real client. Required for correct per-visitor limits in production.
TRUST_PROXY=
# Comma-separated origins allowed to call the public /api cross-origin. Leave empty when the site and API
# share an origin (the default). The admin API is never cross-origin.
ALLOWED_ORIGINS=
# Max write requests per IP per 15 minutes on each form endpoint.
RATE_LIMIT_MAX=30

# --- Database (tier 3) --------------------------------------------------------
# PostgreSQL 14 or newer. REQUIRED when NODE_ENV=production.
#   DATABASE_URL=postgres://zenitheum:password@localhost:5432/zenitheum
DATABASE_URL=
# "" (plain) | true (verify the server certificate) | no-verify (TLS without verification, some managed hosts)
DATABASE_SSL=
PG_POOL_MAX=10
# Development only (no DATABASE_URL): where the embedded database lives. Defaults to server/data/pg.
PGLITE_DIR=
DATA_DIR=

# --- Staff console (/admin) -----------------------------------------------------
# On the first start with an empty database, these create the first administrator (password: 12+ characters).
# Remove ADMIN_PASSWORD afterwards. Or run `npm run admin:create` instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_HOURS=8
ADMIN_LOGIN_LIMIT=10
# auto = Secure cookie in production or over https. Set false ONLY to try a production build on http://localhost.
ADMIN_COOKIE_SECURE=auto

# --- Website analytics (first-party, consent-based) -------------------------------
ANALYTICS_ENABLED=true
# Raw visit data older than this is deleted. Leads keep their own copy of the campaign that brought them.
ANALYTICS_RETENTION_DAYS=540
# "Today" in the dashboard means today in this time zone.
ANALYTICS_TZ=Asia/Kolkata
COLLECT_RATE_MAX=240

# --- E-mail notifications (optional) -----------------------------------------------
# Without SMTP_HOST, submissions are still stored — see them in /admin or with `npm run inbox`.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Zenitheum Website <no-reply@zenitheum.com>"
MAIL_TO_CONTACT=support@zenitheum.com
MAIL_TO_CAREERS=careers@zenitheum.com

# --- Docker Compose (see docker-compose.yml) ------------------------------------------
POSTGRES_PASSWORD=
WEB_PORT=8080
