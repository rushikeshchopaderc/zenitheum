{
  // Cloudflare deployment: the React build (dist/) plus a tiny Worker that forwards /api/* to the Node API.
  "name": "zenitheum",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Replace with the address Render gives your API service (see README, "Deploying for free").
    "API_ORIGIN": "https://zenitheum-api.onrender.com"
  }
}
